{
  "mode": "ask",
  "allowCommands": ["modal", "trigger", "npx", "npm", "node", "ctx7"],
  "dotenv": {
    "enabled": true,
    "files": [".env", ".env.local", ".env.production", ".env.development"],
    "exclude": [".env.example", ".env.sample"]
  },
  "patterns": {
    "openai": true,
    "github": true,
    "google": true,
    "aws": true,
    "jwt": true,
    "pem": true,
    "base64": false
  },
  "base64MinLength": 32
}